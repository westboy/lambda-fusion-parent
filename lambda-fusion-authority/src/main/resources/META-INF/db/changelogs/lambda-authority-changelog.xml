    <changeSet id="lambda-authority-202603120002" author="westboy">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="la_area"/>
            </not>
        </preConditions>
        <createTable tableName="la_area" remarks="行政区划表">
            <column name="ID" type="bigint" remarks="编号">
                <constraints primaryKey="true" primaryKeyName="pk_la_area_id" nullable="false"/>
            </column>
            <column name="AREA_CODE" type="varchar(24)" remarks="区域编码"/>
            <column name="AREA_NAME" type="varchar(64)"/>
            <column name="LEVEL" type="int" remarks="层级"/>
            <column name="DEPTH" type="int" remarks="深度"/>
            <column name="TYPE" type="varchar(12)" remarks="类型"/>
            <column name="PARENT_CODE" type="varchar(64)"/>
        </createTable>
    </changeSet>

    <changeSet id="lambda-authority-202603120003" author="westboy">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="la_clients"/>
            </not>
        </preConditions>
        <createTable tableName="la_clients" remarks="第三方客户端">
            <column name="ID" type="varchar(32)">
                <constraints primaryKey="true" primaryKeyName="pk_la_clients_id" nullable="false"/>
            </column>
            <column name="NAME" type="varchar(255)" remarks="客户端名称">
                <constraints nullable="false"/>
            </column>
            <column name="SECRET" type="varchar(255)" remarks="客户端密钥">
                <constraints nullable="false"/>
            </column>
            <column name="HOSTS" type="varchar(255)" remarks="绑定IP地址"/>
            <column name="CREATED_AT" type="datetime" defaultValueComputed="CURRENT_TIMESTAMP" remarks="创建日期">
                <constraints nullable="false"/>
            </column>
            <column name="UPDATED_AT" type="datetime" defaultValueComputed="CURRENT_TIMESTAMP" remarks="更新时间">
                <constraints nullable="false"/>
            </column>
            <column name="EXPIRED" type="datetime" defaultValueComputed="CURRENT_TIMESTAMP" remarks="过期时间">
                <constraints nullable="false"/>
            </column>
            <column name="ENABLED" type="int" remarks="是否可用"/>
            <column name="REMARKS" type="varchar(400)"/>
            <column name="TENANT_ID" type="varchar(32)" remarks="租户id"/>
            <column name="CREATED_BY" type="varchar(64)"/>
            <column name="UPDATED_BY" type="varchar(64)"/>
        </createTable>
    </changeSet>

    <changeSet id="lambda-authority-202603120004" author="westboy">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="la_organization"/>
            </not>
        </preConditions>
        <createTable tableName="la_organization" remarks="组织机构">
            <column name="ID" type="varchar(32)" remarks="主键">
                <constraints primaryKey="true" primaryKeyName="pk_la_organization_id" nullable="false"/>
            </column>
            <column name="ORG_NAME" type="varchar(64)"/>
            <column name="ALIAS" type="varchar(64)"/>
            <column name="ORG_OWNER" type="varchar(32)" remarks="组织拥有者"/>
            <column name="ORG_CATEGORY" type="int" remarks="组织类别"/>
            <column name="ORG_RANK" type="int" remarks="组织级别"/>
            <column name="ORG_TYPE" type="int" remarks="组织类型"/>
            <column name="PARENT_ID" type="varchar(32)" remarks="父ID，NULL 代表顶级"/>
            <column name="PARENT_KEYS" type="varchar(1000)" remarks="父节点关键字"/>
            <column name="CREATED_AT" type="datetime" defaultValueComputed="CURRENT_TIMESTAMP" remarks="创建日期">
                <constraints nullable="false"/>
            </column>
            <column name="REMARKS" type="varchar(280)" remarks="备注"/>
            <column name="ENABLED" type="int" defaultValueNumeric="1" remarks="是否启用，未启用:0,已启用:1">
                <constraints nullable="false"/>
            </column>
            <column name="TENANT_ID" type="varchar(32)" remarks="租户"/>
            <column name="ORDER_NO" type="int" defaultValueNumeric="1" remarks="组织排序号">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="lambda-authority-2026031200051" author="westboy">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="la_resources"/>
            </not>
        </preConditions>
        <createTable tableName="la_resources" remarks="资源信息表">
            <column name="ID" type="varchar(64)">
                <constraints primaryKey="true" primaryKeyName="pk_la_resources_id" nullable="false"/>
            </column>
            <column name="PARENT_ID" type="varchar(64)"/>
            <column name="RES_NAME" type="varchar(128)" remarks="资源名称"/>
            <column name="RES_PATH" type="varchar(200)" remarks="访问路径"/>
            <column name="RES_LEVEL" type="int" remarks="资源级别"/>
            <column name="RES_TYPE" type="int" remarks="资源类型"/>
            <column name="RES_URL" type="varchar(510)"/>
            <column name="RES_MODE" type="int" defaultValueNumeric="0" remarks="资源模式 0:后台资源,1:APP资源"/>
            <column name="METHOD" type="varchar(255)" remarks="对应后台方法函数"/>
            <column name="ICON" type="varchar(128)"/>
            <column name="HIDDEN" type="int" defaultValueNumeric="0" remarks="是否隐藏">
                <constraints nullable="false"/>
            </column>
            <column name="PARENT_KEYS" type="varchar(1000)" remarks="上级节点集"/>
            <column name="IS_DEV" type="int" defaultValueNumeric="0" remarks="是否是开发者功能, 0:否,1:是">
                <constraints nullable="false"/>
            </column>
            <column name="REMARK" type="varchar(2000)"/>
            <column name="URL" type="varchar(255)" remarks="资源路径"/>
            <column name="KEY_NAME" type="varchar(64)" remarks="国际化KEY"/>
            <column name="KEEP_ALIVE" type="int" defaultValueNumeric="0" remarks="是否缓存"/>
            <column name="EXPAND" type="varchar(1024)" remarks="扩展字段"/>
            <column name="BUSINESS_EXPAND" type="varchar(1024)" remarks="业务扩展字段"/>
            <column name="ORDER_NO" type="int" remarks="排序">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

