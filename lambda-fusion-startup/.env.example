# 复制为 .env 后，请将所有 change-me 占位值替换为本地随机值。
TZ=Asia/Shanghai

APP_PORT=20005
MYSQL_PORT=3306
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

MYSQL_DATABASE=lambda_cloud
MYSQL_USERNAME=lambda_fusion
MYSQL_PASSWORD=change-me-mysql-password
MYSQL_ROOT_PASSWORD=change-me-mysql-root-password

POSTGRES_DATABASE=lambda_ai
POSTGRES_USERNAME=lambda_fusion
POSTGRES_PASSWORD=change-me-postgres-password

REDIS_DATABASE=0
REDIS_PASSWORD=change-me-redis-password

MINIO_ROOT_USER=lambda-fusion
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_BUCKET=lambda-fusion

# AES 密钥，Base64 编码的 32 字节随机值，生成：openssl rand -base64 32
CRYPTO_AES_SECRET_KEY=change-me-base64-encoded-32-byte-key

# 登录凭据传输加密 RSA 密钥对（单行，换行用 \n 拼接）。
# 生成：openssl genpkey -algorithm RSA -out login-private.pem -pkeyopt rsa_keygen_bits:2048
#       openssl rsa -in login-private.pem -pubout -out login-public.pem
CRYPTO_LOGIN_PUBLIC_KEY=change-me-rsa-public-key-pem-single-line
CRYPTO_LOGIN_PRIVATE_KEY=change-me-rsa-private-key-pem-single-line

AI_ATTACHMENT_PREVIEW_SECRET=change-me-with-a-random-attachment-preview-secret

# 独立 Qwen Image 工具；启用前必须填写真实 API Key 和基础地址。
AI_QWEN_IMAGE_TOOL_ENABLED=false
AI_QWEN_IMAGE_API_KEY=
AI_QWEN_IMAGE_BASE_URL=
AI_QWEN_IMAGE_MODEL_NAME=qwen-image-3.0-pro
AI_QWEN_IMAGE_CONNECT_TIMEOUT_SECONDS=10
AI_QWEN_IMAGE_REQUEST_TIMEOUT_SECONDS=120
