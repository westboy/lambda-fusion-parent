<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.lambda.cloud</groupId>
        <artifactId>lambda-fusion-parent</artifactId>
        <version>2026.1.1-SNAPSHOT</version>
    </parent>

    <artifactId>lambda-fusion-form</artifactId>

    <name>lambda-fusion-form</name>

    <dependencies>
        <!-- ORG/USER/ROLE 字段 biz 数据源：经 authority-api 远程契约（工程契约 §7.3，不引用实现类） -->
        <dependency>
            <groupId>com.lambda.cloud</groupId>
            <artifactId>lambda-fusion-authority-api</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>
        <!-- 仅测试作用域：FormRouteIntegrationTest 用真实 authority 服务做 H2 集成验证 -->
        <dependency>
            <groupId>com.lambda.cloud</groupId>
            <artifactId>lambda-fusion-authority</artifactId>
            <scope>test</scope>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>com.lambda.cloud</groupId>
            <artifactId>lambda-fusion-permission-api</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.lambda.cloud</groupId>
            <artifactId>lambda-fusion-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.lambda.cloud</groupId>
            <artifactId>lambda-cloud-starter-mybatis</artifactId>
        </dependency>
        <!-- 快照 JSON 序列化（Jackson 3，版本经 BOM 管理） -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lambda.cloud</groupId>
            <artifactId>lambda-cloud-starter-liquibase</artifactId>
        </dependency>
        <!-- 操作日志：设计子域写操作留痕，缺失时注解静默失效（starter-logger 可选） -->
        <dependency>
            <groupId>com.lambda.cloud</groupId>
            <artifactId>lambda-cloud-starter-logger</artifactId>
        </dependency>
        <!-- 表元数据内省缓存：缺失 CacheManager 时直通实时读取（行为与未引入一致） -->
        <dependency>
            <groupId>com.lambda.cloud</groupId>
            <artifactId>lambda-cloud-starter-cache</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 现有可选集成依赖；运行模型状态与版本由数据库逐次核对。 -->
        <dependency>
            <groupId>com.lambda.cloud</groupId>
            <artifactId>lambda-cloud-starter-dubbo</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 文件字段上传（FILE）：复用 OSS 附件体系；缺失时上传端点不装配，字段退化为文本输入 -->
        <dependency>
            <groupId>com.lambda.cloud</groupId>
            <artifactId>lambda-fusion-oss</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 流程表单数据源（ProcessFormSource SPI，workflow 模块定义）：缺失时设计器表单下拉降级为空、发布校验跳过 -->
        <dependency>
            <groupId>com.lambda.cloud</groupId>
            <artifactId>lambda-fusion-workflow</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 动态数据源组件（设计器按源读表元数据与枚举数据源）：缺失时数据源下拉降级为空、仅主库可映射 -->
        <dependency>
            <groupId>com.lambda.cloud</groupId>
            <artifactId>lambda-fusion-datasource</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <configuration>
                    <!-- 第三方生成的词法解析器插桩后超过 JVM 方法大小限制。 -->
                    <excludes combine.children="append">
                        <exclude>net/sf/jsqlparser/parser/CCJSqlParserTokenManager*</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
