<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.lambda.cloud</groupId>
        <artifactId>lambda-fusion-parent</artifactId>
        <version>2026.1.1-SNAPSHOT</version>
    </parent>

    <artifactId>lambda-fusion-form</artifactId>

    <name>lambda-fusion-form</name>

    <dependencies>
        <dependency>
            <groupId>com.lambda.cloud</groupId>
            <artifactId>lambda-fusion-authority</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.lambda.cloud</groupId>
            <artifactId>lambda-fusion-permission-api</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.lambda.cloud</groupId>
            <artifactId>lambda-fusion-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.lambda.cloud</groupId>
            <artifactId>lambda-cloud-starter-mybatis</artifactId>
        </dependency>
        <!-- 快照 JSON 序列化（Jackson 3，版本经 BOM 管理） -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lambda.cloud</groupId>
            <artifactId>lambda-cloud-starter-liquibase</artifactId>
        </dependency>
        <!-- 操作日志：设计子域写操作留痕，缺失时注解静默失效（starter-logger 可选） -->
        <dependency>
            <groupId>com.lambda.cloud</groupId>
            <artifactId>lambda-cloud-starter-logger</artifactId>
        </dependency>
        <!-- 现有可选集成依赖；运行模型状态与版本由数据库逐次核对。 -->
        <dependency>
            <groupId>com.lambda.cloud</groupId>
            <artifactId>lambda-cloud-starter-dubbo</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <configuration>
                    <!-- 第三方生成的词法解析器插桩后超过 JVM 方法大小限制。 -->
                    <excludes combine.children="append">
                        <exclude>net/sf/jsqlparser/parser/CCJSqlParserTokenManager*</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
