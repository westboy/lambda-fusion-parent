<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="lambda-authority-202603120102" author="westboy">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="la_attachment_groups"/>
            </not>
        </preConditions>
        <createTable tableName="la_attachment_groups" remarks="附件分组表">
            <column name="GROUP_ID" type="varchar(32)" remarks="分组编号">
                <constraints primaryKey="true" primaryKeyName="pk_la_attachment_groups_group_id" nullable="false"/>
            </column>
            <column name="GROUP_NAME" type="varchar(128)" remarks="分组名称">
                <constraints nullable="false"/>
            </column>
            <column name="GROUP_CODE" type="varchar(64)" remarks="分组编码"/>
            <column name="SORT_NO" type="int" defaultValueNumeric="0" remarks="排序号"/>
            <column name="OWNER" type="varchar(128)" remarks="拥有者"/>
            <column name="TENANT_ID" type="varchar(64)" remarks="租户ID"/>
            <column name="CREATED_AT" type="datetime" defaultValueComputed="CURRENT_TIMESTAMP" remarks="创建时间"/>
        </createTable>
    </changeSet>

    <changeSet id="lambda-authority-202603120103" author="westboy">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="la_attachments"/>
            </not>
        </preConditions>
        <createTable tableName="la_attachments" remarks="附件信息表">
            <column name="ATTACHMENT_ID" type="varchar(32)" remarks="附件编号">
                <constraints primaryKey="true" primaryKeyName="pk_la_attachments_attachment_id" nullable="false"/>
            </column>
            <column name="FILE_NAME" type="varchar(255)" remarks="文件名">
                <constraints nullable="false"/>
            </column>
            <column name="FILE_SIZE" type="bigint" remarks="文件大小">
                <constraints nullable="false"/>
            </column>
            <column name="CONTENT_TYPE" type="varchar(128)" remarks="文件类型"/>
            <column name="OBJECT_KEY" type="varchar(1024)" remarks="对象存储KEY">
                <constraints nullable="false"/>
            </column>
            <column name="FILE_URL" type="varchar(1024)" remarks="文件访问地址"/>
            <column name="GROUP_ID" type="varchar(32)" remarks="分组编号"/>
            <column name="CLIENT_NAME" type="varchar(64)" remarks="OSS客户端名称">
                <constraints nullable="false"/>
            </column>
            <column name="OWNER" type="varchar(128)" remarks="拥有者"/>
            <column name="TENANT_ID" type="varchar(64)" remarks="租户ID"/>
            <column name="CREATED_AT" type="datetime" defaultValueComputed="CURRENT_TIMESTAMP" remarks="创建时间"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
