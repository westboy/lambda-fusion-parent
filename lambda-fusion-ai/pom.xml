            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-sandbox-kubernetes</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
