<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.lambda.cloud</groupId>
        <artifactId>lambda-cloud-parent</artifactId>
        <version>2026.1.1-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <artifactId>lambda-fusion-parent</artifactId>
    <packaging>pom</packaging>

    <properties>
        <spotbugs.skip>false</spotbugs.skip>
    </properties>

    <modules>
        <module>lambda-fusion-ai</module>
        <module>lambda-fusion-bom</module>
        <module>lambda-fusion-core</module>
        <module>lambda-fusion-config</module>
        <module>lambda-fusion-authority</module>
        <module>lambda-fusion-dictionary</module>
        <module>lambda-fusion-oss</module>
        <module>lambda-fusion-datasource</module>
        <module>lambda-fusion-permission</module>
        <module>lambda-fusion-authority-api</module>
        <module>lambda-fusion-message-api</module>
        <module>lambda-fusion-message</module>
        <module>lambda-fusion-logger-api</module>
        <module>lambda-fusion-logger</module>
        <module>lambda-fusion-form</module>
        <module>lambda-fusion-workflow</module>
        <module>lambda-fusion-startup</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Reactor 内的可选集成依赖由父工程统一版本；对外消费仍由 fusion BOM 管理。 -->
            <dependency>
                <groupId>com.lambda.cloud</groupId>
                <artifactId>lambda-fusion-authority</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lambda.cloud</groupId>
                <artifactId>lambda-fusion-oss</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lambda.cloud</groupId>
                <artifactId>lambda-fusion-permission-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lambda.cloud</groupId>
                <artifactId>lambda-cloud-starter-dependencies</artifactId>
                <version>2026.1.1-SNAPSHOT</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>com.lambda.cloud</groupId>
            <artifactId>lambda-cloud-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
